{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webauthn-developer-tool",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "dev.canokeys.org",
      "custom_domain": true
    }
  ]
}
